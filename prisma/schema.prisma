generator client {
  provider = "prisma-client-js"
}

// Must be a persistent Postgres database (Render's filesystem is wiped on
// every deploy/restart). Neon or Supabase free tiers work.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Matches the Shopify app template session model, including the fields used
// by expiring offline access tokens.
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

// App settings that belong to the shop rather than to one staff member.
// `language` is the merchant's explicit choice in the language picker. A null
// value means they haven't chosen yet, so the app follows the admin locale
// until they pick one.
model ShopPreference {
  shop String @id
  // BCP-47 code from app/i18n (e.g. "de", "pt-BR"), or null until chosen.
  language         String?
  languageChosenAt DateTime?
}
