generator client {
  provider = "prisma-client-js"
}

// Must be a persistent Postgres database (Render's filesystem is wiped on
// every deploy/restart). Neon or Supabase free tiers work.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Matches the Shopify app template session model, including the fields used
// by expiring offline access tokens.
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}
