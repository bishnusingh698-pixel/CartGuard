{
  "name": "cartguard",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --ssr",
    "dev": "remix vite:dev --host 0.0.0.0 --port 3000",
    "lint": "eslint --ignore-path .gitignore --ext .js,.jsx,.ts,.tsx .",
    "postinstall": "prisma generate && rm -rf node_modules/@shopify/polaris/node_modules/@types",
    "start": "remix-serve ./build/server/index.js",
    "typecheck": "tsc",
    "shopify": "shopify",
    "deploy": "shopify app deploy",
    "test:function": "cd extensions/cartguard-validator && npm run build",
    "test:app": "npm run typecheck"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "@remix-run/dev": "^2.15.0",
    "@remix-run/node": "^2.15.0",
    "@remix-run/react": "^2.15.0",
    "@remix-run/serve": "^2.15.0",
    "@shopify/app-bridge-react": "^4.1.0",
    "@shopify/polaris": "^13.0.0",
    "@shopify/shopify-app-remix": "^3.5.0",
    "@shopify/shopify-app-session-storage-prisma": "^5.0.0",
    "isbot": "^5.1.0",
    "prisma": "^5.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@remix-run/eslint-config": "^2.15.0",
    "@shopify/cli": "latest",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.0",
    "tailwindcss": "^3.4.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "typescript": "^5.4.5",
    "vite": "^5.2.0",
    "vite-tsconfig-paths": "^4.3.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0"
  }
}
