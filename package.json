{
  "name": "cartguard",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "remix vite:build",
    "dev": "remix vite:dev --host 0.0.0.0 --port 3000",
    "start": "remix-serve ./build/server/index.js",
    "setup": "prisma generate",
    "postinstall": "prisma generate",
    "lint": "eslint --ignore-path .gitignore --ext .js,.jsx,.ts,.tsx .",
    "typecheck": "tsc",
    "test": "node scripts/check-locales.mjs && vitest run",
    "check:locales": "node scripts/check-locales.mjs",
    "shopify": "shopify",
    "deploy": "shopify app deploy",
    "function:install": "npm --prefix extensions/cartguard-validator install",
    "function:schema": "shopify app function schema --path extensions/cartguard-validator",
    "function:typegen": "shopify app function typegen --path extensions/cartguard-validator",
    "function:build": "shopify app function build --path extensions/cartguard-validator"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "@remix-run/dev": "^2.15.0",
    "@remix-run/node": "^2.15.0",
    "@remix-run/react": "^2.15.0",
    "@remix-run/serve": "^2.15.0",
    "@shopify/app-bridge-react": "^4.1.0",
    "@shopify/polaris": "^13.0.0",
    "@shopify/shopify-app-remix": "^3.5.0",
    "@shopify/shopify-app-session-storage-prisma": "^5.0.0",
    "flag-icons": "^7.5.0",
    "isbot": "^5.1.0",
    "prisma": "^5.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.4.5",
    "vite": "^5.2.0",
    "vite-tsconfig-paths": "^4.3.2"
  },
  "devDependencies": {
    "@remix-run/eslint-config": "^2.15.0",
    "@shopify/cli": "^3.80.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.1",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0"
  }
}
