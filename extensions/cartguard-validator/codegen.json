{
  "schema": "input-schema.graphql",
  "documents": "src/run.graphql",
  "generates": {
    "generated/api.ts": {
      "plugins": ["typescript", "typescript-operations"],
      "config": {
        "enumsAsTypes": true,
        "skipTypename": false,
        "nonOptionalTypename": false
      }
    }
  }
}
